# Data files (keep essential project data)
data/raw/
data/processed/
# Allow specific data files
!data/**/
*.json
*.jsonl
*.pkl
*.pickle

# Model files (keep essential models)
models/checkpoints/
# Allow saved models and their files
!models/saved_models/
!models/saved_models/*.h5
!models/saved_models/*.hdf5
!models/saved_models/*.model
*.h5
*.hdf5
*.model

# Output files (keep essential results)
!output/*.csv
output/logs/
output/temp/
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# PDF files (since there are PDFs in the repo)
*.pdf

# Temporary files
tmp/
temp/
*.tmp
